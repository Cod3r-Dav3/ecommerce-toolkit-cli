# ==========================================
# Configurações do Gerador de Senhas Seguras
# ==========================================

# Incluir letras maiúsculas (true/false)
UPPERCASE_LETTERS=true

# Incluir letras minúsculas (true/false)
LOWERCASE_LETTERS=true

# Incluir números (true/false)
NUMBERS=true

# Incluir caracteres especiais (true/false)
SPECIAL_CHARACTERS=true

# Comprimento da senha padrão (mínimo: 4, máximo: 128)
PASSWORD_LENGTH=16
